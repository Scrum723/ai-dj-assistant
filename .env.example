# Chief / AI DJ — never commit real keys
# Chief was previously called Halo; legacy HALO_* env vars, !halo commands, halo.db and settings key halo still work.
# Copy to .env or ~/.env; do not commit filled values.

# --- Core / process ---
CHIEF_PORT=8000
# (legacy HALO_* still accepted)
# Railway sets PORT automatically (wins over CHIEF_PORT / HALO_PORT)
DATA_DIR=
# Directory for halo.db, community.db, users.db, library.db (default: backend/)
# Railway: mount a volume here; daily copies land in $DATA_DIR/backups/YYYY-MM-DD/
COOKIE_SECURE=true
# Also forced true when RAILWAY_ENVIRONMENT is set
CORS_ORIGINS=
# Comma-separated; default includes localhost + djbotbotty.com + Railway app
TRUSTED_PROXY=
# Set 1/true to honor X-Forwarded-For (auto on Railway). Avoid XFF spoof when unset.
LOG_FORMAT=
# json on Railway by default; set json locally for structured logs
SENTRY_DSN=
# Optional error reporting
GOOGLE_CLOUD_PROJECT=dj-botbody

# --- Operator / booth control ---
OPERATOR_KEY=
# Required in cloud. Header: X-Operator-Key. Dashboard: localStorage.operatorKey
# When unset, 127.0.0.1 may call /action/*, POST /settings, /agent/*, /sentinel/*

# --- Chief LLM (legacy HALO_* still accepted) ---
CHIEF_PROVIDER=gemini
# gemini | xai (alias: grok)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
XAI_API_KEY=
XAI_MODEL=grok-2-latest
CHIEF_COST_PER_1K=0.0001
CHIEF_DAILY_CALL_CAP=
CHIEF_TRAINING_LEVEL=1
# Optional: CHIEF_MODEL, CHIEF_HOST, CHIEF_DESKTOP

# --- Voice (optional) ---
ELEVENLABS_API_KEY=

# --- Community adapters (disabled in settings by default) ---
YOUTUBE_LIVE_VIDEO_ID=
# Twitch channel is settings.community.adapters.twitch.channel (no token for anon read)

# --- OAuth / booth pass (B3+) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

# --- Local Mac / optional tooling ---
AI_DJ_BRAIN_URL=http://127.0.0.1:8000
# DJ_BACKEND=sim   # C1+: use FakeMidiOut on non-Mac / CI
